# Create .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Data files
*.sdf
*.npy
*.csv
*.png
*.jpg

# Output directories
outputs/
data/

# Environment
venv/
env/
.venv/
.conda/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large files
*.zip
*.tar.gz
*.rar
EOF

# Add .gitignore to staging
git add .gitignore